{
  "name": "projectm-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Project Paige (ProjectM) mentorship childcare platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @projectm/api & npm run dev -w @projectm/web",
    "dev:api": "npm run dev -w @projectm/api",
    "dev:web": "npm run dev -w @projectm/web",
    "build": "npm run build -w @projectm/contracts && npm run build -w @projectm/api && npm run build -w @projectm/web",
    "android:add": "npm run android:add -w @projectm/web",
    "android:sync": "npm run android:sync -w @projectm/web",
    "android:open": "npm run android:open -w @projectm/web",
    "android:bundle": "npm run android:bundle -w @projectm/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run build -w @projectm/contracts && npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @projectm/api",
    "db:migrate": "npm run db:migrate -w @projectm/api",
    "db:seed": "npm run db:seed -w @projectm/api"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  }
}
